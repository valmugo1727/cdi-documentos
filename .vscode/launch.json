{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Ejecutar Gestor Documental CDI",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run.py",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Ejecutar pruebas unitarias",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": ["discover", "-s", "tests", "-t", ".", "-v"],
      "console": "integratedTerminal"
    }
  ]
}
